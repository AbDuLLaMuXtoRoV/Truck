# Backend that /api/* is proxied to (same origin, no CORS). Read by next.config.ts at BUILD time:
# rebuild after changing it. Default: http://127.0.0.1:8010
BACKEND_URL=http://127.0.0.1:8010

# Optional: leave empty (recommended) so the browser calls /api on the dashboard's own origin.
# Set it only to call a backend on another origin directly; that backend must then allow CORS.
NEXT_PUBLIC_API_URL=

