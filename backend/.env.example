# Copy to backend/.env and fill in. Never commit .env.

ENV=dev
# Local dev: SQLite file. Docker / production: Postgres.
DATABASE_URL=sqlite+aiosqlite:///./smart_truck.db
# DATABASE_URL=postgresql+asyncpg://smart:smart@localhost:5432/smart_truck
REDIS_URL=redis://localhost:6379/0
# inline = jobs run inside the API process (no Redis needed); celery = docker/production
TASK_QUEUE=inline

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# --- Telegram ------------------------------------------------------------------
# off | polling (local dev) | webhook (production)
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_GROUP_ACKS=true

# --- AI ------------------------------------------------------------------------
# Requires ANTHROPIC_API_KEY in the environment (or an `ant auth login` profile).
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_DROP_BELOW=0.5
AI_REVIEW_BELOW=0.85
# Keep false during the pilot: every AI task goes through the review queue.
AUTO_ASSIGN_ENABLED=false
ANALYSIS_DEBOUNCE_SECONDS=90
ANALYSIS_MAX_WAIT_SECONDS=300
